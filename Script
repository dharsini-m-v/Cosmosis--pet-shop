const pets=[
["Bruno","85 Days","Gentle, playful and affectionate."],
["Milo","1 Year","Curious, social and wonderfully calm."],
["Coco","120 Days","Bright, cuddly and full of character."],
["Luna","2 Years","Loyal, gentle and people-loving."]
